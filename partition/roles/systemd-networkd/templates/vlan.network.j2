[Match]
Name={{ item.name }}
Type=vlan

[Link]
MTUBytes={{ item.mtu | default(systemd_networkd_mtu) }}

{% if item.address or item.vrf is defined %}
[Network]
{% if item.address is defined %}
Address={{ item.address }}
{% endif %}
{% if item.vrf is defined %}
VRF={{ item.vrf }}
{% endif %}
{% endif %}