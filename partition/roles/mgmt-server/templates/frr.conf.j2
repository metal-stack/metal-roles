frr defaults datacenter
hostname {{ ansible_hostname }}
!
service integrated-vtysh-config
!
log syslog debugging
debug bgp updates
debug bgp nht
debug bgp update-groups
debug bgp zebra
!
{% for route in mgmt_server_frr_static_routes %}
ip route {{ route }}
{% endfor %}
{% if mgmt_server_frr_static_routes | length > 0 %}
!
{% endif %}
interface {{ mgmt_server_spine_facing_interface }}
 ipv6 nd ra-interval 6
 no ipv6 nd suppress-ra
!
{% for vrf in mgmt_server_vrfs %}
{% for iface in vrf.unnumbered_interfaces | default([]) %}
interface {{ iface }}
 ipv6 nd ra-interval 6
 no ipv6 nd suppress-ra
!
{% endfor %}
{% endfor %}
router bgp {{ mgmt_server_asn }}
 bgp router-id {{ mgmt_server_router_id }}
 bgp bestpath as-path multipath-relax
 bgp network import-check
 neighbor FABRIC peer-group
 neighbor FABRIC remote-as external
 neighbor FABRIC timers 1 3
 neighbor {{ mgmt_server_spine_facing_interface }} interface peer-group FABRIC
 {% if mgmt_server_firewall_ip is defined %}
 neighbor {{ mgmt_server_firewall_ip }} peer-group FABRIC
 neighbor {{ mgmt_server_firewall_ip }} disable-connected-check
 {% endif %}
 !
 address-family ipv4 unicast
  redistribute connected route-map LOCAL_INTERFACES
  {% if mgmt_server_provide_default_route %}
  network 0.0.0.0/0
  {% endif %}
 exit-address-family
!
{% for vrf in mgmt_server_vrfs %}
router bgp {{ mgmt_server_asn }} vrf {{ vrf.name }}
 bgp router-id {{ vrf.router_id | default(mgmt_server_router_id) }}
 bgp bestpath as-path multipath-relax
 neighbor FABRIC peer-group
 neighbor FABRIC remote-as external
 neighbor FABRIC timers {{ vrf.bgp_timers | default('1 3') }}
 {% for iface in vrf.unnumbered_interfaces | default([]) %}
 neighbor {{ iface }} interface peer-group FABRIC
 {% endfor %}
 !
 address-family ipv4 unicast
  {% for a in vrf.announcements | default(['redistribute connected']) %}
  {{ a }}
  {% endfor %}
  {% if vrf.routemap_out is defined %}
  neighbor FABRIC route-map {{ vrf.routemap_out.name }} out
  {% endif %}
 exit-address-family
!
{% endfor %}
{% for iface in mgmt_server_frr_match_interfaces %}
route-map LOCAL_INTERFACES permit {{ loop.index }}0
  match interface {{ iface }}
!
{% endfor %}
{% for vrf in mgmt_server_vrfs %}
{% if vrf.routemap_out is defined %}
route-map {{ vrf.routemap_out.name }} permit 10
{% for e in vrf.routemap_out.entries | default([]) %}
 {{ e }}
{% endfor %}
!
{% endif %}
{% endfor %}
line vty
!
