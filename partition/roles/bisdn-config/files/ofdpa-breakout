# Vendored for metal-roles from https://gist.github.com/hwoesner/9bfbfdb5a7eb40739e72f4b360aa54ee
# with one fix: with more than one breakout, the pbmp_* bitmaps only got the
# sub ports of the last one, so the SDK did not create the others (found on an
# AS7726-32X with port4..port10 split into 4x25G).
"""Generate the OF-DPA config.bcm with port breakouts applied.

OF-DPA reads /usr/share/ofdpa/platform/<platform>/config.bcm once at start
and offers no runtime port split, so breakouts have to be written into that
file before ofdpa starts.  This tool keeps the pristine platform file as
config.bcm.dist and regenerates config.bcm from it and /etc/ofdpa/breakout.conf.

breakout.conf syntax (one entry per line, '#' starts a comment):

    port<N>=4x10            split front panel port N into four 10G ports
    port<N>=4x25            split front panel port N into four 25G ports
    port<N>=4x10:55,56,57   same, with explicit numbers for the new ports

Without explicit numbers the new ports get the next free numbers after the
highest existing port, in front panel order, e.g. port50 on a 54 port switch
becomes port50, port55, port56, port57.  Note that OF-DPA (generatePortMap in
BISDN's onl-platform patch) forces dport numbers to be consecutive 1..N: it
walks them in ascending order and closes every gap, so only the relative order
of the numbers in config.bcm matters, and splitting a lower-numbered port later
renumbers the sub ports of higher ones.

Commands:
    apply                   regenerate the platform config.bcm (ExecStartPre)
    show                    print the generated config.bcm to stdout
    generate <config.bcm> <breakout.conf>
                            print the result for arbitrary input files
"""

import os
import re
import sys

PLATFORM_FILE = "/etc/onl/platform"
PLATFORM_DIR = "/usr/share/ofdpa/platform"
BREAKOUT_CONF = "/etc/ofdpa/breakout.conf"
MARKER = "# GENERATED by ofdpa-breakout, edit config.bcm.dist and breakout.conf instead"

LANES = 4
RE_PORTMAP = re.compile(r"^portmap_(\d+)(\.0)?=(\d+):(\d+)(:\d+)?(:[a-z]+)?\s*$")
RE_DPORT = re.compile(r"^dport_map_port_(\d+)=(\d+)\s*$")
RE_PBMP = re.compile(r"^(pbmp_\w+(?:\.0)?)=(0x[0-9a-fA-F]+)\s*$")
# per logical port keys (Tomahawk / Trident2 style, optional .0 suffix)
RE_LANEMAP_L = re.compile(r"^(xgxs_(?:tx|rx)_lane_map_)(\d+)(\.0)?=(\S+)\s*$")
RE_POLARITY_L = re.compile(r"^(phy_xaui_(?:tx|rx)_polarity_flip_)(\d+)(\.0)?=(\S+)\s*$")
# per physical lane keys (Trident3 style)
RE_LANEMAP_P = re.compile(r"^(phy_chain_(?:tx|rx)_lane_map_physical)\{(\d+)\.0\}=(\S+)\s*$")
RE_POLARITY_P = re.compile(r"^(phy_chain_(?:tx|rx)_polarity_flip_physical)\{(\d+)\.0\}=(\S+)\s*$")
RE_CONF = re.compile(r"^port(\d+)\s*=\s*(\d+)x(\d+)(?::([\d,\s]+))?$")


class BreakoutError(Exception):
    pass


def parse_conf(text):
    """Return {front_panel_port: (lanes, speed, [dports] or None)}."""
    result = {}
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        m = RE_CONF.match(line)
        if not m:
            raise BreakoutError("breakout.conf:%d: cannot parse %r" % (lineno, raw))
        port, lanes, speed = int(m.group(1)), int(m.group(2)), int(m.group(3))
        if lanes != LANES:
            raise BreakoutError("breakout.conf:%d: only %dx breakouts are supported"
                                % (lineno, LANES))
        dports = None
        if m.group(4):
            dports = [int(x) for x in m.group(4).replace(" ", "").split(",") if x]
            if len(dports) != LANES - 1:
                raise BreakoutError("breakout.conf:%d: need %d port numbers"
                                    % (lineno, LANES - 1))
        if port in result:
            raise BreakoutError("breakout.conf:%d: port%d listed twice" % (lineno, port))
        result[port] = (lanes, speed, dports)
    return result


def index_config(lines):
    """Collect portmap and dport information from config.bcm lines."""
    portmap = {}   # logical -> (lineno, physical, speed, lanes_suffix, flags, dot0)
    dport = {}     # front panel -> (lineno, logical)
    for i, line in enumerate(lines):
        m = RE_PORTMAP.match(line)
        if m:
            portmap[int(m.group(1))] = (i, int(m.group(3)), int(m.group(4)),
                                        m.group(5) or "", m.group(6) or "",
                                        m.group(2) or "")
            continue
        m = RE_DPORT.match(line)
        if m:
            dport[int(m.group(2))] = (i, int(m.group(1)))
    return portmap, dport


def belongs_to(line, logical, physical):
    """True if a lane map / polarity line describes the 4-lane port at logical/physical."""
    for rx in (RE_LANEMAP_L, RE_POLARITY_L):
        m = rx.match(line)
        if m:
            return int(m.group(2)) == logical
    m = RE_LANEMAP_P.match(line) or RE_POLARITY_P.match(line)
    if m:
        return physical <= int(m.group(2)) < physical + LANES
    return False


def is_four_lane(entry):
    _, _, speed, lanes_suffix, flags, _ = entry
    return not flags and (speed in (40, 100) or lanes_suffix == ":4")


def generate(config_text, conf_text):
    """Return the generated config.bcm text."""
    conf = parse_conf(conf_text)
    lines = [l for l in config_text.splitlines() if l != MARKER]
    if not conf:
        return "\n".join(lines) + "\n"

    portmap, dport = index_config(lines)
    used_dports = set(dport)
    used_logical = set(portmap)
    inserts = {}   # lineno -> [lines to insert after]
    replace = {}   # lineno -> new line

    for panel in sorted(conf):
        lanes, speed, new_dports = conf[panel]
        if panel not in dport:
            raise BreakoutError("port%d does not exist on this platform" % panel)
        _, logical = dport[panel]
        if logical not in portmap:
            raise BreakoutError("port%d: no portmap for logical port %d" % (panel, logical))
        pm_line, physical, pspeed, lanes_suffix, flags, dot0 = portmap[logical]
        if flags:
            raise BreakoutError("port%d: cannot split a %s port" % (panel, flags.strip(":")))
        if not is_four_lane(portmap[logical]):
            raise BreakoutError("port%d: not a 4-lane port (portmap is %d:%d%s)"
                                % (panel, physical, pspeed, lanes_suffix))
        if speed * lanes > pspeed:
            raise BreakoutError("port%d: %dx%dG exceeds port speed %dG" % (panel, lanes, speed, pspeed))

        sub_logical = [logical + k for k in range(1, lanes)]
        clash = [l for l in sub_logical if l in used_logical]
        if clash:
            raise BreakoutError("port%d: logical ports %s already in use, this platform needs "
                                "a hand-written mapping" % (panel, clash))
        used_logical.update(sub_logical)

        if new_dports is None:
            new_dports = [max(used_dports) + k for k in range(1, lanes)]
        clash = [d for d in new_dports if d in used_dports]
        if clash:
            raise BreakoutError("port%d: port numbers %s already in use" % (panel, clash))
        used_dports.update(new_dports)

        new_suffix = ":1" if lanes_suffix else ""
        replace[pm_line] = "portmap_%d%s=%d:%d%s" % (logical, dot0, physical, speed, new_suffix)
        block = ["# port%d split into %dx%dG: lanes 2-%d are port%s" %
                 (panel, lanes, speed, lanes, ", port".join(str(d) for d in new_dports))]
        for k, l in enumerate(sub_logical, 1):
            block.append("portmap_%d%s=%d:%d%s" % (l, dot0, physical + k, speed, new_suffix))
            # copy per-logical-port lane maps, split per-logical-port polarity masks
            for line in lines:
                m = RE_LANEMAP_L.match(line)
                if m and int(m.group(2)) == logical:
                    block.append("%s%d%s=%s" % (m.group(1), l, m.group(3) or "", m.group(4)))
                    continue
                m = RE_POLARITY_L.match(line)
                if m and int(m.group(2)) == logical:
                    bit = (int(m.group(4), 0) >> k) & 1
                    block.append("%s%d%s=0x%x" % (m.group(1), l, m.group(3) or "", bit))
                    continue
                m = RE_LANEMAP_P.match(line)
                if m and int(m.group(2)) == physical:
                    block.append("%s{%d.0}=%s" % (m.group(1), physical + k, m.group(3)))
        # insert after the parent's own lane map / polarity lines
        end = pm_line
        while end + 1 < len(lines) and belongs_to(lines[end + 1], logical, physical):
            end += 1
        inserts.setdefault(end, []).extend(block)

        # the parent keeps lane 0 of its polarity mask
        for i, line in enumerate(lines):
            m = RE_POLARITY_L.match(line)
            if m and int(m.group(2)) == logical:
                replace[i] = "%s%d%s=0x%x" % (m.group(1), logical, m.group(3) or "",
                                              int(m.group(4), 0) & 1)

        dp_line = dport[panel][0]
        inserts.setdefault(dp_line, []).extend(
            "dport_map_port_%d=%d" % (l, d) for l, d in zip(sub_logical, new_dports))

        # sub ports inherit every port bitmap the parent is a member of
        for i, line in enumerate(lines):
            # accumulate: an earlier breakout may already have replaced this line
            m = RE_PBMP.match(replace.get(i, line))
            if not m:
                continue
            value = int(m.group(2), 16)
            if (value >> logical) & 1:
                for l in sub_logical:
                    value |= 1 << l
                width = len(m.group(2)) - 2
                replace[i] = "%s=0x%0*x" % (m.group(1), width, value)

    out = [MARKER]
    for i, line in enumerate(lines):
        out.append(replace.get(i, line))
        out.extend(inserts.get(i, []))
    return "\n".join(out) + "\n"


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        if default is None:
            raise
        return default


def platform_config():
    platform = read(PLATFORM_FILE).strip()
    return os.path.join(PLATFORM_DIR, platform, "config.bcm")


def pristine(config_path):
    """Return the pristine config, refreshing config.bcm.dist from a new package file."""
    dist_path = config_path + ".dist"
    current = read(config_path)
    if not current.startswith(MARKER):
        # package file, possibly freshly upgraded: it is the new pristine config
        if read(dist_path, "") != current:
            with open(dist_path, "w") as f:
                f.write(current)
        return current
    return read(dist_path)


def apply(write):
    config_path = platform_config()
    base = pristine(config_path)
    conf = read(BREAKOUT_CONF, "")
    result = generate(base, conf)
    if not write:
        sys.stdout.write(result)
        return
    if not parse_conf(conf):
        result = base  # no breakouts: run the untouched package file
    if read(config_path) == result:
        return
    tmp = config_path + ".tmp"
    with open(tmp, "w") as f:
        f.write(result)
    os.chmod(tmp, 0o644)
    os.rename(tmp, config_path)
    print("ofdpa-breakout: updated %s" % config_path)


def main(argv):
    try:
        if argv[1:] == ["apply"]:
            apply(write=True)
        elif argv[1:] == ["show"]:
            apply(write=False)
        elif len(argv) == 4 and argv[1] == "generate":
            sys.stdout.write(generate(read(argv[2]), read(argv[3])))
        else:
            sys.stderr.write(__doc__)
            return 2
    except (BreakoutError, OSError) as e:
        sys.stderr.write("ofdpa-breakout: %s\n" % e)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

